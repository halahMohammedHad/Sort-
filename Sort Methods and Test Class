package sort;

import java.util.Arrays;


public class Sort {

   
    public static void main(String[] args) {
      
   
    System.out.println("===== INSERTION SORT =====");

    // Best Case
    Character[] insertionBest = {'A', 'B', 'C', 'D', 'E'};

    // Average Case
    Character[] insertionAverage = {'C', 'A', 'E', 'B', 'D'};

    // Worst Case
    Character[] insertionWorst = {'E', 'D', 'C', 'B', 'A'};

    System.out.println("Best Case:   " + Arrays.toString(insertionBest));
    InsertionSort(insertionBest);
    System.out.println("After:   " + Arrays.toString(insertionBest));

    System.out.println("Average Case:   " + Arrays.toString(insertionAverage));
    InsertionSort(insertionAverage);
    System.out.println("After:        " + Arrays.toString(insertionAverage));

    System.out.println("Worst Case:  " + Arrays.toString(insertionWorst));
    InsertionSort(insertionWorst);
    System.out.println("After:     " + Arrays.toString(insertionWorst));

     System.out.println();
   
    System.out.println("===== MERGE SORT =====");

    // Best Case
    Integer[] mergeBest = {1, 2, 3, 4, 5};

    // Average Case
    Integer[] mergeAverage = {3, 1, 5, 2, 4};

    // Worst Case
    Integer[] mergeWorst = {5, 4, 3, 2, 1};

    System.out.println("Best Case:  " + Arrays.toString(mergeBest));
    MergeSort(mergeBest);
    System.out.println("After:   " + Arrays.toString(mergeBest));

    System.out.println("Average Case: " + Arrays.toString(mergeAverage));
    MergeSort(mergeAverage);
    System.out.println("After:     " + Arrays.toString(mergeAverage));

    System.out.println("Worst Case:   " + Arrays.toString(mergeWorst));
    MergeSort(mergeWorst);
    System.out.println("After:     " + Arrays.toString(mergeWorst));

   System.out.println();
    
    System.out.println("===== SELECTION SORT =====");

    // Best Case
    Integer[] selectionBest = {1, 2, 3, 4, 5};

    // Average Case
    Integer[] selectionAverage = {3, 1, 5, 2, 4};

    // Worst Case
    Integer[] selectionWorst = {5, 4, 3, 2, 1};

    System.out.println("Best Case:    " + Arrays.toString(selectionBest));
    SelectionSort(selectionBest);
    System.out.println("After:        " + Arrays.toString(selectionBest));

    System.out.println("Average Case: " + Arrays.toString(selectionAverage));
    SelectionSort(selectionAverage);
    System.out.println("After:        " + Arrays.toString(selectionAverage));

    System.out.println("Worst Case:   " + Arrays.toString(selectionWorst));
    SelectionSort(selectionWorst);
    System.out.println("After:        " + Arrays.toString(selectionWorst));


     System.out.println();
    System.out.println("===== QUICK SORT =====");

    // Best Case
    String[] quickBest = {"Apple", "Banana", "Cat", "Dog", "Fish"};

    // Average Case
    String[] quickAverage = {"Cat", "Apple", "Fish", "Banana", "Dog"};

    // Worst Case
    String[] quickWorst = {"Apple", "Banana", "Cat", "Dog", "Fish"};

    System.out.println("Best Case:    " + Arrays.toString(quickBest));
    QuickSort(quickBest, 0, quickBest.length - 1);
    System.out.println("After:        " + Arrays.toString(quickBest));

    System.out.println("Average Case: " + Arrays.toString(quickAverage));
    QuickSort(quickAverage, 0, quickAverage.length - 1);
    System.out.println("After:        " + Arrays.toString(quickAverage));

    System.out.println("Worst Case:   " + Arrays.toString(quickWorst));

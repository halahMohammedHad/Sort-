    public static <E extends Comparable<E>> void SelectionSort(E[] A){
        for(int i=0;i<A.length;i++){
            int min=i;
            for(int j=1;j<A.length;j++){
                if(A[j].compareTo(A[min])<0)
                    min=j;
            }
            E temp=A[i];
            A[i]=A[min];
            A[min]=temp;
            
        }
    }
    
    public static <E extends Comparable<E>> void InsertionSort(E[] B){
        for(int i=1;i<B.length;i++){
            for(int j=i;j>0;j--){
                if(B[j].compareTo(B[j-1])<0){
                    E temp=B[j];
                    B[j]=B[j-1];
                    B[j-1]=temp;
                }
                
            }
        }
    }
    
    public static <E extends Comparable<E>> void MergeSort(E[] C){
        if(C.length==1)
            return;
        E[] c1=Arrays.copyOfRange(C, 0, C.length/2);
        E[] c2=Arrays.copyOfRange(C,C.length/2, C.length);
        
        MergeSort(c1);
        MergeSort(c2);
        
        Merge(C,c1, c2);
        
        
    }
    
  public static <E extends Comparable<E>> void Merge(
        E[] A, E[] left, E[] right) {       // Merge left and right into A

    int i = 0;                              
    int j = 0;                             
    int k = 0;                           

    while (i < left.length && j < right.length) { 

        if (left[i].compareTo(right[j]) < 0) {    

            A[k] = left[i];                        
            i++;                                   

        } else {

            A[k] = right[j];                      
            j++;                                   
        }

        k++;                                      
    }

    while (i < left.length) {                      

        A[k] = left[i];                             
        i++;                                       
        k++;                                      
    }

    while (j < right.length) {                  

        A[k] = right[j];                           
        j++;                                       
        k++;                                     
    }
}
  
  
  public static <E extends Comparable<E>> void QuickSort(
        E[] D, int start, int end) {

    if (start >= end)
        return;

    int pivot = end;
    int left = start;
    int right = end - 1;

    while (left <= right) {

        while (left <= right &&
               D[left].compareTo(D[pivot]) < 0) {
            left++;
        }

        while (left <= right &&
               D[right].compareTo(D[pivot]) > 0) {
            right--;
        }

        if (left <= right) {

            E temp = D[left];
            D[left] = D[right];
            D[right] = temp;

            left++;
            right--;
        }
    }

    // Swap pivot with left
    E temp = D[left];
    D[left] = D[pivot];
    D[pivot] = temp;

    // Recursion
    QuickSort(D, start, left - 1);
    QuickSort(D, left + 1, end);
}
 
}

